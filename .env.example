# Copy to .env.local for local dev, and set the same keys in Vercel for deploy.
# Never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Either key name works (client accepts both):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key

# Public site URL (production). Used in email links.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# --- Optional: email when someone answers your question ---
# In-app bell works after you run supabase/notifications.sql (no keys needed).
# Email needs both of these (Resend free tier is fine):
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# RESEND_API_KEY=re_xxxx
# RESEND_FROM=Volmiq <onboarding@resend.dev>

# --- Google login (free on Supabase) ---
# Enable Google in Supabase → Authentication → Providers
# Add redirect: https://YOUR_PROJECT.supabase.co/auth/v1/callback
# and Site URL / redirect allow list for localhost + production.
